# =============================================================================
# eluno-books — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Each package can also have its own .env for package-specific settings
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# STATIC ASSETS SERVER
# Used by: eluno-deploy, eluno-publish-media
# -----------------------------------------------------------------------------
UPLOAD_HOST=your-server-ip
UPLOAD_PORT=22
UPLOAD_USER=your-username
UPLOAD_KEY_PATH=~/.ssh/id_rsa
# UPLOAD_PASS=your-password  # Legacy, prefer UPLOAD_KEY_PATH
UPLOAD_DIR=/path/to/public_html/static

# -----------------------------------------------------------------------------
# CLOUDFLARE PAGES API (deploys + env var management)
# Used by: scripts that PATCH deployment_configs.production.env_vars
# Dos métodos de auth (usar UNO):
#
#   A) API Token (recomendado, scope mínimo):
#      Crear en https://dash.cloudflare.com/profile/api-tokens
#      Permisos: Account > Cloudflare Pages > Edit
#      Header: -H "Authorization: Bearer $CF_API_TOKEN"
#
#   B) Global API Key (legacy, acceso total):
#      Headers: -H "X-Auth-Email: $CF_EMAIL" -H "X-Auth-Key: $CF_API_KEY"
# -----------------------------------------------------------------------------
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_EMAIL=
# CF_API_KEY=

# -----------------------------------------------------------------------------
# STATIC SUBDOMAIN (media URL rewrite)
# Used by: @eluno/core build (resolveMediaUrl in lib/build/media.js)
# Si están seteadas, las URLs de audio/PDF en media.json se reescriben a
#   https://${STATIC_SUBDOMAIN}/${PROJECT_SLUG}${path}
# Si faltan, los paths quedan tal cual (modo dev local).
# Definir por package en packages/<libro>/.env (PROJECT_SLUG cambia por libro).
# -----------------------------------------------------------------------------
# STATIC_SUBDOMAIN=static.eluno.org
# PROJECT_SLUG=<jesus|sanacion|todo|dormidos|doctrinas>

# -----------------------------------------------------------------------------
# OPTIONAL: API KEYS
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# Audio: eluno-audio usa Edge TTS (gratis, sin API key)
