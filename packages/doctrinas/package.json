{
  "name": "@eluno/doctrinas",
  "version": "0.1.0",
  "description": "Nuestras Doctrinas - Libro digital con audiolibro",
  "scripts": {
    "sass:watch": "sass --watch ../../node_modules/@eluno/core/scss/main.scss:dist/css/main.css",
    "sass:build": "sass ../../node_modules/@eluno/core/scss/main.scss:dist/css/main.css --style=compressed",
    "serve": "live-server dist --port=3007",
    "dev": "concurrently \"pnpm run sass:watch\" \"pnpm run serve\"",
    "build": "pnpm run sass:build && node scripts/build.js && pnpm run build:revision",
    "build:preview": "node scripts/build-preview.js",
    "audio": "eluno-audio",
    "audio:extract": "eluno-audio extract",
    "audio:generate": "eluno-audio generate",
    "audio:assemble": "eluno-audio assemble",
    "audio:concat": "eluno-audio concat",
    "audio:tag": "eluno-audio tag",
    "build:revision": "node scripts/build-revision.js"
  },
  "dependencies": {
    "@eluno/core": "github:chuchurex/eluno-core#v2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "sass": "^1.97.3"
  }
}
